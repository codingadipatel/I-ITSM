# Use: python3 scripts/setup-env.py (generates local secrets)
DB_USER=iitsm
DB_PASSWORD=replace-with-a-strong-database-password
DB_URL=jdbc:postgresql://127.0.0.1:55432/iitsm
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_ENABLED=true
DEMO_PASSWORD=replace-with-a-demo-password-at-least-10-characters

# SMTP is optional for local development. Leave SMTP_HOST empty to hold mail in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM defaults to SMTP_USERNAME when omitted.
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional comma-separated source=destination email delivery overrides; login emails stay unchanged.
EMAIL_RECIPIENT_OVERRIDES=
